<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F4FF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find Your Stay 🏠"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#29213D"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search rooms by location"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginTop="5dp"/>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:hint="📍 Enter location e.g. Pune"
        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textCapWords"
        android:padding="16dp"
        android:background="@drawable/search_bar_background"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Properties"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#29213D"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProperties"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>