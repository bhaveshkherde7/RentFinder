<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Property 🏠"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#29213D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add your room or PG details"
            android:textSize="14sp"
            android:textColor="#777777"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>


        <!-- ================= PROPERTY NAME ================= -->

        <EditText
            android:id="@+id/etPropertyName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="🏠 Property Name"
            android:padding="15dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:background="@drawable/input_background"/>


        <!-- ================= LOCATION ================= -->

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="📍 Location"
            android:padding="15dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:layout_marginTop="15dp"
            android:background="@drawable/input_background"/>


        <!-- ================= RENT ================= -->

        <EditText
            android:id="@+id/etRent"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="💰 Monthly Rent"
            android:inputType="number"
            android:padding="15dp"
            android:singleLine="true"
            android:layout_marginTop="15dp"
            android:background="@drawable/input_background"/>


        <!-- ================= ROOM TYPE ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Type"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerRoomType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="10dp"
            android:background="@drawable/input_background"/>


        <!-- ================= FOOD ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food Availability 🍱"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerFood"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="10dp"
            android:background="@drawable/input_background"/>


        <!-- ================= WIFI ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi 📶"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerWifi"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="10dp"
            android:background="@drawable/input_background"/>


        <!-- ================= AC ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Air Conditioning ❄️"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerAC"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="10dp"
            android:background="@drawable/input_background"/>


        <!-- ================= DESCRIPTION ================= -->

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="📝 Property Description"
            android:gravity="top|start"
            android:padding="15dp"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginTop="18dp"
            android:background="@drawable/input_background"/>


        <!-- ================================================= -->
        <!-- ================= ROOM PHOTOS =================== -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Photos 📸"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#29213D"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/input_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add photos of your room"
                android:textSize="14sp"
                android:textColor="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You can select up to 3 photos"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="3dp"/>

            <Button
                android:id="@+id/btnAddRoomPhoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📸 ADD ROOM PHOTOS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/owner_add_button"
                android:layout_marginTop="12dp"/>

            <!-- PHOTO PREVIEW -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/imgRoom1"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="#E8E4F5"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/imgRoom2"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="#E8E4F5"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/imgRoom3"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="centerCrop"
                    android:background="#E8E4F5"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPhotoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No photos selected"
                android:textSize="13sp"
                android:textColor="#777777"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- ================= SUBMIT BUTTON ================= -->

        <Button
            android:id="@+id/btnSaveProperty"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SUBMIT PROPERTY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/owner_add_button"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp"/>

    </LinearLayout>

</ScrollView>