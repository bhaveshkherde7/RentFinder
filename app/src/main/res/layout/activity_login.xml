<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- TOP LOGO -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="⌂"
            android:textSize="52sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/logo_background"/>

        <!-- APP NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UniStay"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#5E35B1"
            android:layout_marginTop="18dp"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find Your Perfect Stay"
            android:textSize="16sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <!-- LOGIN CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/login_card_background"
            android:elevation="5dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back 👋"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#29213D"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login to continue to UniStay"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="22dp"/>

            <!-- EMAIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:background="@drawable/input_background">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✉"
                    android:textSize="21sp"
                    android:textColor="#673AB7"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Email address"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:background="@android:color/transparent"
                    android:inputType="textEmailAddress"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"/>

            </LinearLayout>

            <!-- PASSWORD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/input_background">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="18sp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:background="@android:color/transparent"
                    android:inputType="textPassword"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"/>

                <!-- SHOW/HIDE PASSWORD -->
                <ImageButton
                    android:id="@+id/btnShowPassword"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_visibility_off"
                    android:contentDescription="Show password"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- ROLE TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login as"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="7dp"/>

            <!-- ROLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:background="@drawable/input_background">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="19sp"/>

                <Spinner
                    android:id="@+id/spinnerRole"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

            <!-- LOGIN BUTTON -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="LOGIN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/login_button_background"
                android:elevation="3dp"
                android:layout_marginTop="25dp"/>

            <!-- REGISTER -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="CREATE NEW ACCOUNT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/register_button_background"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe • Simple • Student Friendly"
            android:textSize="13sp"
            android:textColor="#999999"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
